SECRET_KEY=replace-with-a-long-random-production-secret
DATABASE_URL=postgresql://username:password@localhost:5432/portfolio_db
ADMIN_USERNAME=replace-with-production-admin-username
ADMIN_PASSWORD=replace-with-a-strong-production-admin-password
ADMIN_EMAIL=replace-with-production-admin-email
FLASK_ENV=production
FLASK_DEBUG=0
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=static/uploads
